AI_PROVIDER=cloudflare
# Daily quotas reset at midnight in this timezone. Defaults to Asia/Kolkata.
# PICTUREWISE_TIMEZONE=Asia/Kolkata
# Optional local web port (defaults to 5000):
# PICTUREWISE_PORT=5001
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Used to translate Tamil/Hindi prompts to English before image generation.
CLOUDFLARE_TRANSLATION_MODEL=@cf/meta/m2m100-1.2b
# CLOUDFLARE_TRANSLATION_API_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run/@cf/meta/m2m100-1.2b
# Optional custom endpoint override:
# CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run/@cf/black-forest-labs/flux-1-schnell

# Optional Hugging Face provider:
# AI_PROVIDER=huggingface
# HF_TOKEN=
# HF_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# HF_API_URL=https://router.huggingface.co/hf-inference/models/stabilityai/stable-diffusion-3-medium-diffusers
